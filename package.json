{
  "name": "@cyriusweng/omp-code-model",
  "version": "0.1.0",
  "description": "Same-conversation coding-model phases for OMP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyriusweng/omp-code-model.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "extension",
    "coding-agent"
  ],
  "bin": {
    "omp-session-cost": "./bin/session-cost.mjs"
  },
  "scripts": {
    "test": "node --import ./test/register-loader.mjs --test test/*.test.mjs",
    "check": "for file in src/*.mjs bin/*.mjs test/*.mjs; do node --check \"$file\" || exit; done",
    "session-cost": "node ./bin/session-cost.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "omp": {
    "extensions": [
      "./src/index.mjs"
    ]
  },
  "files": [
    "src",
    "bin",
    "prompts",
    "README.md",
    "LICENSE"
  ]
}
